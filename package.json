{
  "name": "eclipse-rougelike",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "codegen": "convex codegen",
    "build": "tsc -b && npm run typecheck:eclipse && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node tools/run-tests-batched.mjs",
    "test:all": "npm test",
    "test:run": "npm test",
    "test:stable": "npm test",
    "test:ui": "vitest --ui",
    "typecheck": "tsc -b && npm run typecheck:eclipse",
    "typecheck:eclipse": "tsc -p tsconfig.eclipse.json",
    "test:second-dawn": "vitest run --maxWorkers=1 src/__tests__/second_dawn",
    "test:second-dawn:visual": "node tools/second-dawn-check-visual.mjs",
    "test:second-dawn:header": "node tools/second-dawn-check-header.mjs",
    "test:second-dawn:player-cards": "node tools/second-dawn-check-player-cards.mjs",
    "test:second-dawn:rift-feedback": "node tools/second-dawn-check-rift-feedback.mjs",
    "test:second-dawn:inspector-scroll": "node tools/second-dawn-check-inspector-scroll.mjs",
    "test:ci": "npm test",
    "test:ci:shard1": "NODE_OPTIONS=--max-old-space-size=4096 vitest run --pool=forks --maxWorkers=1 --reporter=dot --shard=1/6",
    "test:ci:shard2": "NODE_OPTIONS=--max-old-space-size=4096 vitest run --pool=forks --maxWorkers=1 --reporter=dot --shard=2/6",
    "test:ci:shard3": "NODE_OPTIONS=--max-old-space-size=4096 vitest run --pool=forks --maxWorkers=1 --reporter=dot --shard=3/6",
    "test:ci:shard4": "NODE_OPTIONS=--max-old-space-size=4096 vitest run --pool=forks --maxWorkers=1 --reporter=dot --shard=4/6",
    "test:ci:shard5": "NODE_OPTIONS=--max-old-space-size=4096 vitest run --pool=forks --maxWorkers=1 --reporter=dot --shard=5/6",
    "test:ci:shard6": "NODE_OPTIONS=--max-old-space-size=4096 vitest run --pool=forks --maxWorkers=1 --reporter=dot --shard=6/6",
    "test:tools": "node tools/run-tests-batched.mjs --node && node tools/run-tests-batched.mjs --python",
    "test:batched": "node tools/run-tests-batched.mjs",
    "ci": "npm run check:full",
    "orchestrator": "bash orchestrator.sh",
    "agents": "bash scripts/agents.sh",
    "agents:check": "node tools/agents-check.mjs",
    "agents:logs": "node tools/agents-logs.mjs",
    "agents:logs:all": "node tools/agents-logs.mjs --all",
    "agents:logs:one": "node tools/agents-logs.mjs --agent=$AGENT --lines=${LINES:-60}",
    "second-dawn:local": "node tools/second-dawn-local.mjs",
    "test:second-dawn:local": "node --test tools/second-dawn-local.test.mjs",
    "test:second-dawn:visual-checker": "node --test tools/second-dawn-check-visual.test.mjs",
    "build:vercel": "node tools/build-vercel.mjs",
    "publish:vercel-backend": "node tools/check-convex-release.mjs && convex dev --once --typecheck enable --tail-logs disable",
    "build:frontend": "npm run build",
    "build:codegen": "npm run codegen && npm run build",
    "build:release": "npm run publish:vercel-backend && npm run build",
    "typecheck:backend": "tsc -p convex/tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test:inventory": "node tools/run-tests-batched.mjs --inventory",
    "test:browser": "node tools/run-browser-verification.mjs",
    "format": "node tools/format-maintainability.mjs --write",
    "format:check": "node tools/format-maintainability.mjs",
    "check:quick": "npm run lint && npm run format:check && npm run typecheck && npm run test:tools && npm run test:smoke",
    "check:full": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:tools && npm run build:frontend && npm run test:browser",
    "test:smoke": "node tools/run-tests-batched.mjs --smoke"
  },
  "dependencies": {
    "@vercel/analytics": "^1.5.0",
    "convex": "^1.26.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.7.7",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "convex-test": "0.0.38",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}
